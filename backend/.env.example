# Copy this file to backend/.env and paste your OpenAI API key.
# Created automatically on first run; npm run dev / start / backend also run ensure:env.
# If the key is missing, interactive setup runs automatically (or run: npm run ai:setup).
# Set AISETUP_SKIP_AI_SETUP=1 to skip the prompt and use template-only mode.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional failover: if the OpenAI call fails, the AI gateway retries on Anthropic
# before dropping to the deterministic templates. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the models behind the SIMPLE / NORMAL / COMPLEX task tiers.
# Sol is left out of the defaults on cost grounds; set the COMPLEX tier to it only
# if a heavy document run justifies the price.
# AISETUP_AI_MODEL_SIMPLE=gpt-5.6-luna
# AISETUP_AI_MODEL_NORMAL=gpt-5.6-luna
# AISETUP_AI_MODEL_COMPLEX=gpt-5.6-terra

# JWT signing secret (min 32 characters). Required when using Spring profile "prod".
# JWT_SECRET=change-me-to-a-long-random-string

# Optional toggles (defaults are fine for local/dev):
# AISETUP_SEED_USERS=true
# AISETUP_DEMO_MODE=true

# Gmail SMTP for registration email OTP and document "Sent Emails" delivery.
# Create an App Password after enabling 2FA (do not use your normal Gmail password).
# Free Gmail is fine for low volume (~100–500 msgs/day); From must be this Gmail address.
# SMTP_USERNAME=your@gmail.com
# SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# MAIL_FROM=your@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# Semaphore SMS for registration phone OTP (https://semaphore.co).
# SEMAPHORE_API_KEY=
# SEMAPHORE_SENDER_NAME=DOSTXII

# MySQL profile (default local creds match backend/scripts/mysql-bootstrap.sql).
# SPRING_PROFILES_ACTIVE=mysql
# MYSQL_URL=jdbc:mysql://localhost:3306/aisetup?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
# MYSQL_USER=aisetup
# MYSQL_PASSWORD=aisetup
