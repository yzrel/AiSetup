# Spring Boot API base URL (context path /api is included in default)
VITE_API_URL=http://localhost:8080/api

# Optional: Anthropic key for backend AI assist (synced into backend/.env on startup)
# ANTHROPIC_API_KEY=sk-ant-...
# Set AISETUP_SKIP_AI_SETUP=1 to skip the interactive key prompt on startup

# JWT signing secret for Spring Security (min 32 chars). Required in prod profile.
# JWT_SECRET=change-me-to-a-long-random-string

# Frontend: set to "production" to hide demo credentials and disable demo unlock
# VITE_APP_ENV=production

# Backend OTP (also documented in backend/.env.example):
# SMTP_USERNAME / SMTP_PASSWORD / MAIL_FROM — Gmail App Password for email OTP
# SEMAPHORE_API_KEY / SEMAPHORE_SENDER_NAME — Semaphore for SMS OTP
